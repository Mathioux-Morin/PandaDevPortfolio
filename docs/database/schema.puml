'
' Portfolio database schema (PostgreSQL).
' Light blue table: already created by db/init/. Other tables: proposed.
' Field details: docs/database/data_dictionary.md (keep both files in sync).
' Render: plantuml -tsvg docs/database/schema.puml

@startuml schema
hide circle
hide methods
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor #EBF3FA
    BorderColor #2E75B6
    FontColor #1F4E79
    AttributeFontColor #1F4E79
    HeaderBackgroundColor #2E75B6
    HeaderFontColor #FFFFFF
    BackgroundColor<<existing>> #D5E8F0
}
' Recent PlantUML versions ignore HeaderFontColor: set it with a style instead.
<style>
classDiagram {
    class {
        header {
            FontColor #FFFFFF
        }
    }
    .existing {
        header {
            FontColor #1F4E79
        }
    }
}
</style>
skinparam package {
    BorderColor #2E75B6
    FontColor #1F4E79
}
skinparam legend {
    BackgroundColor #EBF3FA
    BorderColor #2E75B6
    FontColor #1F4E79
}
skinparam note {
    BackgroundColor #F5F9FF
    BorderColor #2E75B6
    FontColor #1F4E79
}
skinparam ArrowColor #2E75B6
skinparam ArrowFontColor #1F4E79
skinparam packageStyle rectangle
skinparam nodesep 80
skinparam ranksep 120
skinparam linetype ortho

legend top right
    **PK** primary key, **FK** foreign key
    **L10n** = jsonb {"fr": "...", "en": "..."}, "en" optional (French fallback)
    <<existing>>: table already in db/init/
    **level**: 0-24 beginner, 25-49 intermediate, 50-74 advanced, 75-100 expert
    Filled diamond: composition (ON DELETE CASCADE)
    Empty diamond: aggregation (ON DELETE SET NULL)
    Dotted line: association table of a many-to-many link
    Details: data_dictionary.md
endlegend

package "People" #DDE8F8 {
    entity users <<existing>> {
        **idUser** : integer <<PK>>
        --
        login : text <<unique>>
        password_hash : text
        password_changed_at : timestamptz  // to add (migration)
    }

    entity profiles {
        **idUser** : integer <<PK, FK>>
        --
        slug : text <<unique>>
        is_public : boolean  // false = hidden portfolio
        display_name : text
        headline : L10n
        bio : L10n
        location : text <<nullable>>
        contact_email : text <<nullable>>
        contact_phone : text <<nullable>>  // international format, e.g. +33612345678
        contact_form_enabled : boolean
        availability : text <<nullable>>  // open_to_work | internship | apprenticeship | not_available
        now : L10n <<nullable>>  // what the person is working on
        now_updated_at : timestamptz <<nullable>>
        created_at : timestamptz
        updated_at : timestamptz
    }

    entity attaches {
        **idUser** : integer <<PK, FK>>
        **idMedia** : uuid <<PK, FK>>
        --
        kind : text  // avatar | cv_fr | cv_en, one per kind
    }

    entity social_links {
        **idSocialLink** : integer <<PK>>
        --
        idUser : integer <<FK>>
        kind : text <<FK>>  // not certificate
        url : text  // checked against link_kinds.url_pattern
        label : text <<nullable>>  // tells apart two links of the same kind
        position : integer
    }

    entity experiences {
        **idExperience** : integer <<PK>>
        --
        idUser : integer <<FK>>
        kind : text  // work | education | training
        organization : text
        title : L10n  // job, degree or course
        employment_status : text <<nullable>>  // work only: employee | supervisor | executive
        contract_type : text <<nullable>>  // work only: permanent | fixed_term | apprenticeship | internship | temporary | freelance
        description : L10n
        location : text <<nullable>>
        start_on : date
        end_on : date <<nullable>>
    }

    entity experience_links {
        **idExperienceLink** : integer <<PK>>
        --
        idExperience : integer <<FK>>
        kind : text <<FK>>
        url : text  // checked against link_kinds.url_pattern
        label : text <<nullable>>
        position : integer
    }

    entity involves {
        **idExperience** : integer <<PK, FK>>
        **idSkill** : integer <<PK, FK>>
    }

    entity masters {
        **idUser** : integer <<PK, FK>>
        **idSkill** : integer <<PK, FK>>
        --
        score : smallint  // CHECK 0..100
        level : text <<generated>>  // from score
        position : integer
    }
}

package "Projects" #DDE8F8 {
    entity projects {
        **idProject** : integer <<PK>>
        --
        slug : text <<unique>>
        title : L10n
        summary : L10n
        content : L10n <<nullable>>  // Markdown
        idCover : uuid <<FK, unique, nullable>>
        repo_url : text <<nullable>>
        demo_url : text <<nullable>>
        started_on : date
        ended_on : date <<nullable>>
        is_published : boolean
        is_featured : boolean
        position : integer
        updated_at : timestamptz
    }

    entity works_on {
        **idProject** : integer <<PK, FK>>
        **idUser** : integer <<PK, FK>>
        --
        status : text  // pending | accepted
        role : L10n <<nullable>>  // e.g. back-end, database
    }

    entity shows {
        **idProject** : integer <<PK, FK>>
        **idMedia** : uuid <<PK, FK>>
        --
        position : integer
    }

    entity uses {
        **idProject** : integer <<PK, FK>>
        **idSkill** : integer <<PK, FK>>
    }
}

package "Catalog" #DDE8F8 {
    entity skills {
        **idSkill** : integer <<PK>>
        --
        name : L10n <<unique fr>>  // e.g. Python, Teamwork
        category : text  // language | framework | database | tool | ai | domain | method | design | art | soft_skill
        icon : text <<nullable>>  // e.g. i-simple-icons-python
    }

    entity link_kinds {
        **kind** : text <<PK>>  // e.g. github, youtube, certificate
        --
        url_pattern : text  // PostgreSQL regex
        icon : text
    }
}

package "Files" #DDE8F8 {
    entity media {
        **idMedia** : uuid <<PK>>
        --
        idOwner : integer <<FK, nullable>>
        storage_key : text <<unique>>  // file in uploads/ or S3
        mime_type : text
        width : integer <<nullable>>
        height : integer <<nullable>>
        size_bytes : bigint
        alt : L10n
        created_at : timestamptz
    }
}

' UML notation, top to bottom: People, then Files and Catalog, then Projects.

' Composition: the part is deleted with its owner (ON DELETE CASCADE).
users "1" *-down- "0..1" profiles
users "1" *-down- "0..*" experiences
users "1" *-down- "0..*" social_links
experiences "1" *-down- "0..*" experience_links

' Reference: the kind of a link (ON DELETE RESTRICT).
link_kinds "1" -up- "0..*" social_links : kind
link_kinds "1" -up- "0..*" experience_links : kind

' Aggregation: optional link, the media survives (ON DELETE SET NULL).
users "0..1" o-down- "0..*" media : owner
media "0..1" -down-o "0..1" projects : cover

' Many-to-many associations, carried by an association table.
profiles "0..*" -down- "0..3" media : avatar, CV (fr, en)
(profiles, media) .. attaches
users "0..*" -down- "0..*" skills
(users, skills) .. masters
experiences "0..*" -down- "0..*" skills
(experiences, skills) .. involves
users "1..*" -down- "0..*" projects : member
(users, projects) .. works_on
skills "0..*" -down- "0..*" projects
(skills, projects) .. uses
media "0..*" -down- "0..*" projects : gallery
(media, projects) .. shows

' Layout only: invisible links that keep each table close to what it links.
experiences -[hidden]down- involves
social_links -[hidden]down- masters
profiles -[hidden]down- attaches
experience_links -[hidden]down- link_kinds
masters -[hidden]down- skills
attaches -[hidden]down- media
skills -[hidden]down- projects
' Repeated on purpose: pulls projects right under media, so that cover and
' gallery leave media far apart instead of side by side.
media -[hidden]down- projects
media -[hidden]down- projects
media -[hidden]down- projects
@enduml
