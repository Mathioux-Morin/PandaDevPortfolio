# ============================================================
# PostgreSQL — Portfolio database container
# ============================================================
# Only used when the database is created (empty volume).
POSTGRES_USER="portfolio"
# Long random password (e.g. openssl rand -base64 32).
POSTGRES_PASSWORD=""
POSTGRES_DB="portfolio"

# Port exposed on 127.0.0.1 of the host machine.
POSTGRES_PORT=5432
