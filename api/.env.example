# ============================================================
# PostgreSQL — Database
# ============================================================
# Connection URL (libpq format, also usable with psql).
# With db/compose.yaml: postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:POSTGRES_PORT/POSTGRES_DB
DATABASE_URL="postgresql://portfolio:password@localhost:5432/portfolio"

# ============================================================
# JWT — Authentication
# ============================================================
# Secret key used to sign the tokens. Must be long and random in production.
JWT_SECRET_KEY=""
# Signing algorithm (HS256 recommended).
JWT_ALGORITHM="HS256"
# Token lifetime in minutes.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
