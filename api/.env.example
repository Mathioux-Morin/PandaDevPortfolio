# ============================================================
# PostgreSQL — Base de données
# ============================================================
# URL de connexion (format libpq, utilisable aussi avec psql).
# Avec bdd/compose.yaml : postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:POSTGRES_PORT/POSTGRES_DB
DATABASE_URL="postgresql://portfolio:motdepasse@localhost:5432/portfolio"

# ============================================================
# JWT — Authentification
# ============================================================
# Clé secrète utilisée pour signer les tokens. Doit être longue et aléatoire en production.
JWT_SECRET_KEY=""
# Algorithme de signature (HS256 recommandé).
JWT_ALGORITHM="HS256"
# Durée de validité d'un token en minutes.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
