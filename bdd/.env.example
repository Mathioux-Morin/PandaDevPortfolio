# ============================================================
# PostgreSQL — Conteneur de la base du portfolio
# ============================================================
# Utilisés uniquement à la création de la base (volume vide).
POSTGRES_USER="portfolio"
# Mot de passe long et aléatoire (ex : openssl rand -base64 32).
POSTGRES_PASSWORD=""
POSTGRES_DB="portfolio"

# Port exposé sur 127.0.0.1 de la machine hôte.
POSTGRES_PORT=5432
